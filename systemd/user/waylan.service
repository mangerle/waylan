[Unit]
Description=WayLan Input Method Daemon
Documentation=https://github.com/waylan/waylan
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=!XDG_CURRENT_DESKTOP=ubuntu:GNOME
ConditionEnvironment=!XDG_CURRENT_DESKTOP=GNOME

[Service]
Type=simple
ExecStart=/usr/bin/waylan
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=5s
Slice=session.slice

[Install]
WantedBy=graphical-session.target
