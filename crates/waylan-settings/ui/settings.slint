import { Button, ScrollView } from "std-widgets.slint";
import { PhraseItem, NavItem, PrimaryButton, CloudProfileItem, ShortcutHelper, ShortcutRecorder } from "common.slint";
import { GeneralTab } from "general_tab.slint";
import { ThemeTab } from "theme_tab.slint";
import { PinyinTab } from "pinyin_tab.slint";
import { FuzzyTab } from "fuzzy_tab.slint";
import { DictTab } from "dict_tab.slint";
import { UserDataTab } from "user_data_tab.slint";
import { ShortcutsTab } from "shortcuts_tab.slint";
import { VoiceTab } from "voice_tab.slint";
import { AboutTab } from "about_tab.slint";

export { PhraseItem, CloudProfileItem, ShortcutHelper }

export component SettingsWindow inherits Window {
    title: "WayLan Settings";
    icon: @image-url("../../../assets/waylan.svg");
    min-width: 860px;
    min-height: 560px;
    preferred-width: 900px;
    preferred-height: 620px;
    background: #f8fafc;

    // 导航项索引 (0: 常规, 1: 外观与主题, 2: 拼音模式, 3: 模糊音, 4: 词典, 5: 用户数据, 6: 快捷键, 7: 语音输入, 8: 关于)
    in-out property <int> active_tab: 0;

    // 应用程序版本（由 Rust 在启动时通过 env!("CARGO_PKG_VERSION") 动态注入）
    in-out property <string> app_version: "1.0.0";

    // 常规设置属性
    in-out property <int> init_lang_index: 0;
    in-out property <int> init_char_width_index: 0;
    in-out property <int> init_punct_width_index: 0;
    in-out property <int> init_simp_trad_index: 0;
    in-out property <int> window_mode_index: 0;
    in-out property <int> density_index: 1;
    in-out property <int> theme_preset_index: 0;
    in-out property <float> candidate_item_spacing: 8;
    in-out property <float> candidate_padding_v: 4;
    in-out property <float> candidate_padding_h: 8;
    in-out property <float> candidate_corner_radius: 8;
    in-out property <float> candidate_opacity: 95;
    in-out property <float> page_size_val: 5;
    in-out property <float> font_size_val: 15;
    in-out property <int> orientation_index: 0;
    in-out property <int> index_style_index: 0;
    in-out property <bool> dynamic_adjust_freq: true;
    in-out property <bool> shift_select_second: false;
    in-out property <bool> auto_pangu_spacing: false;
    in-out property <bool> v_mode: true;
    in-out property <bool> slash_to_dunhao: true;
    in-out property <bool> backslash_to_dunhao: true;
    in-out property <bool> protect_digits_punctuation: true;
    in-out property <bool> auto_complete_pairs: true;
    in-out property <int> enable_tray_index: 0;
    in-out property <bool> exclusive_input_source: false;

    // 拼音模式属性
    in-out property <bool> enable_acronym: true;
    in-out property <bool> page_keys_minus_equal: true;
    in-out property <bool> page_keys_bracket: false;
    in-out property <bool> page_keys_comma_period: false;
    in-out property <bool> typo_enable: false;
    in-out property <bool> typo_gn_ng: true;
    in-out property <bool> typo_mg_ng: true;
    in-out property <bool> typo_iou_iu: true;
    in-out property <bool> typo_uei_ui: true;
    in-out property <bool> typo_uen_un: true;
    in-out property <bool> typo_ue_ve: true;
    in-out property <bool> typo_v_u: true;
    in-out property <bool> typo_on_ong: true;
    in-out property <bool> enable_u_mode: true;
    in-out property <bool> enable_i_mode: true;
    in-out property <bool> filter_uncommon_charset: false;
    in-out property <bool> show_pinyin_comment: true;
    in-out property <bool> auto_dedup: true;

    // 模糊音属性
    in-out property <bool> fuzzy_pinyin: false;
    in-out property <bool> fuzzy_c_ch: false;
    in-out property <bool> fuzzy_z_zh: false;
    in-out property <bool> fuzzy_s_sh: false;
    in-out property <bool> fuzzy_an_ang: false;
    in-out property <bool> fuzzy_en_eng: false;
    in-out property <bool> fuzzy_in_ing: false;
    in-out property <bool> fuzzy_l_n: false;
    in-out property <bool> fuzzy_f_h: false;
    in-out property <bool> fuzzy_r_l: false;
    in-out property <bool> fuzzy_g_k: false;

    // 词典与状态统计属性
    in property <string> base_dict_info: "系统预编译词库: base.dict.bin (正在读取词库状态...)";
    in property <string> english_dict_info: "已就绪常用英文单词: 0 词";
    in property <string> symbols_dict_info: "已收录语义符号与表情: 0 项";
    in-out property <string> pinyin_import_path: "";
    in property <string> pinyin_import_status: "";
    in-out property <string> english_import_path: "";
    in property <string> english_import_status: "";
    in-out property <string> symbols_import_path: "";
    in property <string> symbols_import_status: "";

    // 用户数据属性
    in property <string> user_model_info: "自适应个性化历史词模型: 0 条记忆";
    in-out property <string> new_phrase_code: "";
    in-out property <string> new_phrase_text: "";
    in property <[PhraseItem]> phrase_list: [];
    in property <string> phrase_status: "";

    // 快捷键属性
    in-out property <int> switch_key_index: 0;
    in-out property <string> traditional_shortcut: "Ctrl + Shift + F";
    in-out property <string> full_width_char_shortcut: "Shift + Space";
    in-out property <string> full_width_punct_shortcut: "Ctrl + .";

    // 语音输入属性
    in-out property <bool> voice_enabled: false;
    in-out property <int> toggle_shortcut_index: 0;
    in-out property <string> toggle_shortcut: "Ctrl + Alt + V";
    in-out property <int> ptt_shortcut_index: 0;
    in-out property <string> push_to_talk_shortcut: "F8";
    in-out property <bool> afe_enabled: true;
    in-out property <bool> high_pass_filter: true;
    in-out property <bool> noise_suppression: true;
    in property <[string]> ns_model_names: ["[内置] RNNoise 智能降噪 (轻量日常)", "[深度] DeepFilterNet3 (强力消除机械键盘)", "[SOTA] GTCRN 深度降噪 (523KB 极速)"];
    in-out property <int> ns_model_index: 0;
    in-out property <bool> auto_gain_control: true;
    in-out property <int> vad_silence_delay_index: 1;
    in property <[string]> vad_model_names: ["[内置] Silero VAD (神经网络模型)", "[算法] 纯能量门限 (零模型纯数学 RMS)"];
    in-out property <int> vad_model_index: 0;
    in property <[string]> asr_model_names: ["[本地] 阿里 Paraformer (中文流式 int8)"];
    in-out property <int> asr_model_index: 0;
    in property <string> asr_notice_text: "当前处于【本地离线模式】: 采用阿里 Paraformer 流式 int8 ONNX 引擎，所有音频计算均在本地完成，零延迟、零网络依赖、保障隐私安全。";
    in property <bool> is_asr_cloud: false;
    in-out property <bool> auto_punctuation: true;
    in property <[string]> punct_model_names: ["[内置] CT-Transformer 深度标点 (int8)", "[规则] 基础句末规则兜底 (无模型)"];
    in-out property <int> punct_model_index: 0;

    // 阶段五：文本规整与语气词过滤 (ITN)
    in-out property <bool> itn_convert_numbers: true;
    in-out property <bool> itn_filter_filler_words: true;
    in-out property <bool> itn_pangu_spacing: true;

    // 阶段六：交互展现与流式上屏
    in-out property <bool> voice_real_time_preview: true;
    in-out property <bool> voice_show_floating_bar: true;
    in-out property <int> voice_visual_effect_index: 0;

    // 语音二级 Tab 与云端管理
    in-out property <int> voice_sub_tab: 0;
    in property <[CloudProfileItem]> cloud_profiles: [];
    in property <bool> is_editing_cloud: false;
    in-out property <string> edit_cloud_name: "";
    in-out property <string> edit_cloud_endpoint: "https://api.openai.com/v1/audio/transcriptions";
    in-out property <string> edit_cloud_key: "";
    in-out property <string> edit_cloud_model: "whisper-1";

    // 全局操作反馈
    in property <string> global_status: "";
    in property <bool> global_status_is_error: false;

    // 回调事件
    callback save_settings();
    callback reset_defaults();
    callback pick_and_import_pinyin();
    callback pick_and_import_english();
    callback pick_and_import_symbols();
    callback add_custom_phrase(string, string);
    callback delete_custom_phrase(int);
    callback clear_user_model();
    callback import_asr_model();
    callback import_vad_model();
    callback import_punct_model();
    callback import_ns_model();
    callback open_models_directory();
    callback start_add_cloud_profile();
    callback start_edit_cloud_profile(int);
    callback delete_cloud_profile(int);
    callback save_cloud_profile(string, string, string, string);
    callback cancel_cloud_edit();
    callback test_cloud_profile(int);

    HorizontalLayout {
        // ---------------- 左侧菜单侧边栏 ----------------
        Rectangle {
            width: 160px;
            background: #f8fafc;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                // 侧边栏顶部品牌标题（配合品牌 Logo）
                HorizontalLayout {
                    padding_top: 2px;
                    padding_bottom: 8px;
                    spacing: 9px;
                    alignment: start;

                    Image {
                        source: @image-url("../../../assets/waylan.svg");
                        width: 36px;
                        height: 36px;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "微澜输入法";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "偏好设置中心";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #e2e8f0;
                }

                // 侧边栏 8 项导航菜单
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_general.svg");
                    title: "常规";
                    active: root.active_tab == 0;
                    clicked => { root.active_tab = 0; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_theme.svg");
                    title: "外观与主题";
                    active: root.active_tab == 1;
                    clicked => { root.active_tab = 1; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_pinyin.svg");
                    title: "拼音模式";
                    active: root.active_tab == 2;
                    clicked => { root.active_tab = 2; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_fuzzy.svg");
                    title: "模糊音";
                    active: root.active_tab == 3;
                    clicked => { root.active_tab = 3; }
                }

                Rectangle {
                    height: 1px;
                    background: #f1f5f9;
                }

                NavItem {
                    icon: @image-url("../../../assets/icons/nav_dict.svg");
                    title: "词典";
                    active: root.active_tab == 4;
                    clicked => { root.active_tab = 4; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_user_data.svg");
                    title: "用户数据";
                    active: root.active_tab == 5;
                    clicked => { root.active_tab = 5; }
                }

                Rectangle {
                    height: 1px;
                    background: #f1f5f9;
                }

                NavItem {
                    icon: @image-url("../../../assets/icons/nav_shortcuts.svg");
                    title: "快捷键";
                    active: root.active_tab == 6;
                    clicked => { root.active_tab = 6; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_voice.svg");
                    title: "语音输入";
                    active: root.active_tab == 7;
                    clicked => { root.active_tab = 7; }
                }
                NavItem {
                    icon: @image-url("../../../assets/icons/nav_about.svg");
                    title: "关于";
                    active: root.active_tab == 8;
                    clicked => { root.active_tab = 8; }
                }

                Rectangle { } // 弹性占位
            }
        }

        // 分割线
        Rectangle {
            width: 1px;
            background: #e2e8f0;
        }

        // ---------------- 右侧内容面板 ----------------
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 24px;
            spacing: 16px;

            // 页面标题与简介栏
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.active_tab == 0 ? "常规" :
                          root.active_tab == 1 ? "外观与主题" :
                          root.active_tab == 2 ? "拼音模式" :
                          root.active_tab == 3 ? "模糊音" :
                          root.active_tab == 4 ? "词典" :
                          root.active_tab == 5 ? "用户数据" :
                          root.active_tab == 6 ? "快捷键" :
                          root.active_tab == 7 ? "语音输入" : "关于";
                    font-size: 20px;
                    font-weight: 700;
                    color: #0f172a;
                }
                Text {
                    text: root.active_tab == 0 ? "配置输入法初始语言、字符全半角、候选排版容量、中西文智能空格与系统顶栏指示器" :
                          root.active_tab == 1 ? "定制微澜现代候选框渲染引擎、预设色彩风格与空间排版留白密度" :
                          root.active_tab == 2 ? "配置拼音检索模式、翻页快捷键及拼音智能纠错选项" :
                          root.active_tab == 3 ? "配置平翘舌、前后鼻音与易混淆音节模糊匹配规则" :
                          root.active_tab == 4 ? "查看系统词库状态，导入外部拼音、英文与符号词库" :
                          root.active_tab == 5 ? "管理用户快捷短语展开规则与自适应历史自造词记忆" :
                          root.active_tab == 6 ? "配置中英切换键，查看输入法预设快捷键映射指南" :
                          root.active_tab == 7 ? "配置语音输入快捷按键、端侧离线 Paraformer 模型、标点预测与云端服务" : "微澜输入法版本信息、技术架构与开源许可声明";
                    font-size: 12px;
                    color: #64748b;
                }
            }

            Rectangle {
                height: 1px;
                background: #e2e8f0;
            }

            // 右侧核心滚动内容区
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    spacing: 0px;

                    if root.active_tab == 0: GeneralTab {
                        init_lang_index <=> root.init_lang_index;
                        init_char_width_index <=> root.init_char_width_index;
                        init_punct_width_index <=> root.init_punct_width_index;
                        init_simp_trad_index <=> root.init_simp_trad_index;
                        dynamic_adjust_freq <=> root.dynamic_adjust_freq;
                        shift_select_second <=> root.shift_select_second;
                        auto_pangu_spacing <=> root.auto_pangu_spacing;
                        v_mode <=> root.v_mode;
                        slash_to_dunhao <=> root.slash_to_dunhao;
                        backslash_to_dunhao <=> root.backslash_to_dunhao;
                        protect_digits_punctuation <=> root.protect_digits_punctuation;
                        auto_complete_pairs <=> root.auto_complete_pairs;
                        enable_tray_index <=> root.enable_tray_index;
                        exclusive_input_source <=> root.exclusive_input_source;
                        orientation_index <=> root.orientation_index;
                        index_style_index <=> root.index_style_index;
                        page_size_val <=> root.page_size_val;
                        font_size_val <=> root.font_size_val;
                    }

                    if root.active_tab == 1: ThemeTab {
                        window_mode_index <=> root.window_mode_index;
                        theme_preset_index <=> root.theme_preset_index;
                        density_index <=> root.density_index;
                        candidate_item_spacing <=> root.candidate_item_spacing;
                        candidate_padding_v <=> root.candidate_padding_v;
                        candidate_padding_h <=> root.candidate_padding_h;
                        candidate_corner_radius <=> root.candidate_corner_radius;
                        candidate_opacity_val <=> root.candidate_opacity;
                        orientation_index: root.orientation_index;
                        index_style_index: root.index_style_index;
                        page_size_val: root.page_size_val;
                        font_size_val: root.font_size_val;
                    }

                    if root.active_tab == 2: PinyinTab {
                        enable_acronym <=> root.enable_acronym;
                        typo_enable <=> root.typo_enable;
                        typo_gn_ng <=> root.typo_gn_ng;
                        typo_mg_ng <=> root.typo_mg_ng;
                        typo_iou_iu <=> root.typo_iou_iu;
                        typo_uei_ui <=> root.typo_uei_ui;
                        typo_uen_un <=> root.typo_uen_un;
                        typo_ue_ve <=> root.typo_ue_ve;
                        typo_v_u <=> root.typo_v_u;
                        typo_on_ong <=> root.typo_on_ong;
                        enable_u_mode <=> root.enable_u_mode;
                        enable_i_mode <=> root.enable_i_mode;
                        filter_uncommon_charset <=> root.filter_uncommon_charset;
                        show_pinyin_comment <=> root.show_pinyin_comment;
                        auto_dedup <=> root.auto_dedup;
                    }

                    if root.active_tab == 3: FuzzyTab {
                        fuzzy_pinyin <=> root.fuzzy_pinyin;
                        fuzzy_c_ch <=> root.fuzzy_c_ch;
                        fuzzy_z_zh <=> root.fuzzy_z_zh;
                        fuzzy_s_sh <=> root.fuzzy_s_sh;
                        fuzzy_an_ang <=> root.fuzzy_an_ang;
                        fuzzy_en_eng <=> root.fuzzy_en_eng;
                        fuzzy_in_ing <=> root.fuzzy_in_ing;
                        fuzzy_l_n <=> root.fuzzy_l_n;
                        fuzzy_f_h <=> root.fuzzy_f_h;
                        fuzzy_r_l <=> root.fuzzy_r_l;
                        fuzzy_g_k <=> root.fuzzy_g_k;
                    }

                    if root.active_tab == 4: DictTab {
                        base_dict_info: root.base_dict_info;
                        english_dict_info: root.english_dict_info;
                        symbols_dict_info: root.symbols_dict_info;
                        pinyin_import_path <=> root.pinyin_import_path;
                        pinyin_import_status: root.pinyin_import_status;
                        english_import_path <=> root.english_import_path;
                        english_import_status: root.english_import_status;
                        symbols_import_path <=> root.symbols_import_path;
                        symbols_import_status: root.symbols_import_status;
                        pick_and_import_pinyin => { root.pick_and_import_pinyin(); }
                        pick_and_import_english => { root.pick_and_import_english(); }
                        pick_and_import_symbols => { root.pick_and_import_symbols(); }
                    }

                    if root.active_tab == 5: UserDataTab {
                        user_model_info: root.user_model_info;
                        new_phrase_code <=> root.new_phrase_code;
                        new_phrase_text <=> root.new_phrase_text;
                        phrase_list: root.phrase_list;
                        phrase_status: root.phrase_status;
                        clear_user_model => { root.clear_user_model(); }
                        add_custom_phrase(code, text) => { root.add_custom_phrase(code, text); }
                        delete_custom_phrase(idx) => { root.delete_custom_phrase(idx); }
                    }

                    if root.active_tab == 6: ShortcutsTab {
                        switch_key_index <=> root.switch_key_index;
                        page_keys_minus_equal <=> root.page_keys_minus_equal;
                        page_keys_bracket <=> root.page_keys_bracket;
                        page_keys_comma_period <=> root.page_keys_comma_period;
                        traditional_shortcut <=> root.traditional_shortcut;
                        full_width_char_shortcut <=> root.full_width_char_shortcut;
                        full_width_punct_shortcut <=> root.full_width_punct_shortcut;
                    }

                    if root.active_tab == 7: VoiceTab {
                        active_sub_tab <=> root.voice_sub_tab;
                        voice_enabled <=> root.voice_enabled;
                        toggle_shortcut_index <=> root.toggle_shortcut_index;
                        toggle_shortcut <=> root.toggle_shortcut;
                        ptt_shortcut_index <=> root.ptt_shortcut_index;
                        push_to_talk_shortcut <=> root.push_to_talk_shortcut;

                        afe_enabled <=> root.afe_enabled;
                        high_pass_filter <=> root.high_pass_filter;
                        noise_suppression <=> root.noise_suppression;
                        ns_model_names: root.ns_model_names;
                        ns_model_index <=> root.ns_model_index;
                        auto_gain_control <=> root.auto_gain_control;

                        vad_silence_delay_index <=> root.vad_silence_delay_index;
                        vad_model_names: root.vad_model_names;
                        vad_model_index <=> root.vad_model_index;

                        asr_model_names: root.asr_model_names;
                        asr_model_index <=> root.asr_model_index;
                        asr_notice_text: root.asr_notice_text;
                        is_asr_cloud: root.is_asr_cloud;

                        auto_punctuation <=> root.auto_punctuation;
                        punct_model_names: root.punct_model_names;
                        punct_model_index <=> root.punct_model_index;

                        itn_convert_numbers <=> root.itn_convert_numbers;
                        itn_filter_filler_words <=> root.itn_filter_filler_words;
                        itn_pangu_spacing <=> root.itn_pangu_spacing;

                        custom_theme_enabled: root.window_mode_index == 0;
                        voice_real_time_preview <=> root.voice_real_time_preview;
                        voice_show_floating_bar <=> root.voice_show_floating_bar;
                        voice_visual_effect_index <=> root.voice_visual_effect_index;

                        cloud_profiles: root.cloud_profiles;
                        is_editing_cloud: root.is_editing_cloud;
                        edit_cloud_name <=> root.edit_cloud_name;
                        edit_cloud_endpoint <=> root.edit_cloud_endpoint;
                        edit_cloud_key <=> root.edit_cloud_key;
                        edit_cloud_model <=> root.edit_cloud_model;

                        import_asr_model => { root.import_asr_model(); }
                        import_vad_model => { root.import_vad_model(); }
                        import_punct_model => { root.import_punct_model(); }
                        import_ns_model => { root.import_ns_model(); }
                        open_models_directory => { root.open_models_directory(); }
                        start_add_cloud_profile => { root.start_add_cloud_profile(); }
                        start_edit_cloud_profile(idx) => { root.start_edit_cloud_profile(idx); }
                        delete_cloud_profile(idx) => { root.delete_cloud_profile(idx); }
                        save_cloud_profile(name, endpoint, key, model) => {
                            root.save_cloud_profile(name, endpoint, key, model);
                        }
                        cancel_cloud_edit => { root.cancel_cloud_edit(); }
                        test_cloud_profile(idx) => { root.test_cloud_profile(idx); }
                    }

                    if root.active_tab == 8: AboutTab {
                        app_version: root.app_version;
                    }
                }
            }

            // 底部常驻全局操作栏与反馈提示
            Rectangle {
                height: 1px;
                background: #e2e8f0;
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    horizontal-stretch: 1;
                    alignment: start;

                    if root.global_status != "": Text {
                        text: root.global_status;
                        font-size: 13px;
                        color: root.global_status_is_error ? #dc2626 : #059669;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 12px;
                    alignment: end;

                    Button {
                        text: "恢复默认设置";
                        clicked => { root.reset_defaults(); }
                    }

                    PrimaryButton {
                        text: "保存设置并应用";
                        clicked => { root.save_settings(); }
                    }
                }
            }
        }
    }
}
