import { VoicePipelineTab } from "voice_pipeline_tab.slint";
import { VoiceCloudTab } from "voice_cloud_tab.slint";
import { CloudProfileItem } from "common.slint";

export component VoiceTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 18px;

    // 二级 Tab 索引 (0: 语音流水线, 1: 云端服务管理)
    in-out property <int> active_sub_tab: 0;

    // 基础触发属性
    in-out property <bool> voice_enabled: false;
    in-out property <int> toggle_shortcut_index: 0;
    in-out property <string> toggle_shortcut: "Ctrl + Alt + V";
    in-out property <int> ptt_shortcut_index: 0;
    in-out property <string> push_to_talk_shortcut: "F8";

    // 阶段一：AFE 前端增强
    in-out property <bool> afe_enabled: true;
    in-out property <bool> high_pass_filter: true;
    in-out property <bool> noise_suppression: true;
    in property <[string]> ns_model_names: ["[内置] RNNoise 智能降噪 (轻量日常)", "[深度] DeepFilterNet3 (强力消除机械键盘)", "[SOTA] GTCRN 深度降噪 (523KB 极速)"];
    in-out property <int> ns_model_index: 0;
    in-out property <bool> auto_gain_control: true;

    // 阶段二：VAD 端点检测
    in-out property <int> vad_silence_delay_index: 1;
    in property <[string]> vad_model_names: ["[内置] Silero VAD (神经网络模型)", "[算法] 纯能量门限 (零模型纯数学 RMS)"];
    in-out property <int> vad_model_index: 0;

    // 阶段三：ASR 核心识别
    in property <[string]> asr_model_names: ["[本地] 阿里 Paraformer (中文流式 int8)"];
    in-out property <int> asr_model_index: 0;
    in property <string> asr_notice_text: "当前处于【本地离线模式】: 采用阿里 Paraformer 流式 int8 ONNX 引擎，所有音频计算均在本地完成，零延迟、零网络依赖、保障隐私安全。";
    in property <bool> is_asr_cloud: false;

    // 阶段四：标点预测
    in-out property <bool> auto_punctuation: true;
    in property <[string]> punct_model_names: ["[内置] CT-Transformer 深度标点 (int8)", "[规则] 基础句末规则兜底 (无模型)"];
    in-out property <int> punct_model_index: 0;

    // 阶段五：文本规整与语气词过滤 (ITN)
    in-out property <bool> itn_convert_numbers: true;
    in-out property <bool> itn_filter_filler_words: true;
    in-out property <bool> itn_pangu_spacing: true;

    // 阶段六：交互展现与流式上屏
    in property <bool> custom_theme_enabled: true;
    in-out property <bool> voice_real_time_preview: true;
    in-out property <bool> voice_show_floating_bar: true;
    in-out property <int> voice_visual_effect_index: 0;

    // 云端服务配置列表与编辑状态
    in property <[CloudProfileItem]> cloud_profiles: [];
    in property <bool> is_editing_cloud: false;
    in-out property <string> edit_cloud_name: "";
    in-out property <string> edit_cloud_endpoint: "https://api.openai.com/v1/audio/transcriptions";
    in-out property <string> edit_cloud_key: "";
    in-out property <string> edit_cloud_model: "whisper-1";

    // 回调事件
    callback import_asr_model();
    callback import_vad_model();
    callback import_punct_model();
    callback import_ns_model();
    callback open_models_directory();
    callback start_add_cloud_profile();
    callback start_edit_cloud_profile(int);
    callback delete_cloud_profile(int);
    callback save_cloud_profile(string, string, string, string);
    callback cancel_cloud_edit();
    callback test_cloud_profile(int);

    // ---------------- 顶部二级 Tab 导航栏 ----------------
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        height: 38px;

        // 标签 1：语音流水线
        Rectangle {
            border-radius: 6px;
            background: root.active_sub_tab == 0 ? #eff6ff : (touch_pipeline.has-hover ? #f1f5f9 : transparent);
            border-width: 1px;
            border-color: root.active_sub_tab == 0 ? #bfdbfe : transparent;

            touch_pipeline := TouchArea {
                clicked => { root.active_sub_tab = 0; }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                alignment: center;
                Text {
                    text: "语音流水线 (Pipeline)";
                    font-size: 13px;
                    font-weight: root.active_sub_tab == 0 ? 700 : 500;
                    color: root.active_sub_tab == 0 ? #1d4ed8 : #64748b;
                    vertical-alignment: center;
                }
            }
        }

        // 标签 2：云端服务管理
        Rectangle {
            border-radius: 6px;
            background: root.active_sub_tab == 1 ? #eff6ff : (touch_cloud.has-hover ? #f1f5f9 : transparent);
            border-width: 1px;
            border-color: root.active_sub_tab == 1 ? #bfdbfe : transparent;

            touch_cloud := TouchArea {
                clicked => { root.active_sub_tab = 1; }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                alignment: center;
                Text {
                    text: "云端服务管理";
                    font-size: 13px;
                    font-weight: root.active_sub_tab == 1 ? 700 : 500;
                    color: root.active_sub_tab == 1 ? #1d4ed8 : #64748b;
                    vertical-alignment: center;
                }
                Rectangle {
                    border-radius: 8px;
                    background: root.active_sub_tab == 1 ? #dbeafe : #e2e8f0;
                    height: 16px;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: root.cloud_profiles.length;
                            font-size: 10px;
                            font-weight: 700;
                            color: root.active_sub_tab == 1 ? #1e40af : #475569;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    Rectangle { height: 1px; background: #e2e8f0; }

    // ---------------- 二级视图内容渲染 ----------------
    if root.active_sub_tab == 0: VoicePipelineTab {
        voice_enabled <=> root.voice_enabled;
        toggle_shortcut_index <=> root.toggle_shortcut_index;
        toggle_shortcut <=> root.toggle_shortcut;
        ptt_shortcut_index <=> root.ptt_shortcut_index;
        push_to_talk_shortcut <=> root.push_to_talk_shortcut;

        afe_enabled <=> root.afe_enabled;
        high_pass_filter <=> root.high_pass_filter;
        noise_suppression <=> root.noise_suppression;
        ns_model_names: root.ns_model_names;
        ns_model_index <=> root.ns_model_index;
        auto_gain_control <=> root.auto_gain_control;

        vad_silence_delay_index <=> root.vad_silence_delay_index;
        vad_model_names: root.vad_model_names;
        vad_model_index <=> root.vad_model_index;

        asr_model_names: root.asr_model_names;
        asr_model_index <=> root.asr_model_index;
        asr_notice_text: root.asr_notice_text;
        is_asr_cloud: root.is_asr_cloud;

        auto_punctuation <=> root.auto_punctuation;
        punct_model_names: root.punct_model_names;
        punct_model_index <=> root.punct_model_index;

        itn_convert_numbers <=> root.itn_convert_numbers;
        itn_filter_filler_words <=> root.itn_filter_filler_words;
        itn_pangu_spacing <=> root.itn_pangu_spacing;

        custom_theme_enabled: root.custom_theme_enabled;
        voice_real_time_preview <=> root.voice_real_time_preview;
        voice_show_floating_bar <=> root.voice_show_floating_bar;
        voice_visual_effect_index <=> root.voice_visual_effect_index;

        switch_to_cloud_tab => { root.active_sub_tab = 1; }
        import_asr_model => { root.import_asr_model(); }
        import_vad_model => { root.import_vad_model(); }
        import_punct_model => { root.import_punct_model(); }
        import_ns_model => { root.import_ns_model(); }
        open_models_directory => { root.open_models_directory(); }
    }

    if root.active_sub_tab == 1: VoiceCloudTab {
        cloud_profiles: root.cloud_profiles;
        is_editing: root.is_editing_cloud;
        edit_name <=> root.edit_cloud_name;
        edit_endpoint <=> root.edit_cloud_endpoint;
        edit_key <=> root.edit_cloud_key;
        edit_model <=> root.edit_cloud_model;

        start_add_profile => { root.start_add_cloud_profile(); }
        start_edit_profile(idx) => { root.start_edit_cloud_profile(idx); }
        delete_profile(idx) => { root.delete_cloud_profile(idx); }
        save_profile(name, endpoint, key, model) => {
            root.save_cloud_profile(name, endpoint, key, model);
        }
        cancel_edit => { root.cancel_cloud_edit(); }
        test_profile(idx) => { root.test_cloud_profile(idx); }
    }
}
