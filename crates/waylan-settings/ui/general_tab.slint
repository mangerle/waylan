import { CheckBox, ComboBox, Slider } from "std-widgets.slint";
import { SettingCard } from "common.slint";

export component GeneralTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    // 初始状态属性
    in-out property <int> init_lang_index: 0;       // 0: 中文, 1: 英文
    in-out property <int> init_char_width_index: 0; // 0: 半角, 1: 全角
    in-out property <int> init_punct_width_index: 0;// 0: 全角标点, 1: 半角标点
    in-out property <int> init_simp_trad_index: 0;  // 0: 简体中文, 1: 繁体中文

    // 候选框外观
    in-out property <float> page_size_val: 7;
    in-out property <float> font_size_val: 15;
    in-out property <int> orientation_index: 0;     // 0: 水平横排, 1: 垂直竖排
    in-out property <int> theme_index: 0;           // 0: 浅色, 1: 深色

    // 候选词与打字行为
    in-out property <bool> dynamic_adjust_freq: true;
    in-out property <bool> shift_select_second: false;
    in-out property <bool> auto_pangu_spacing: false;
    in-out property <bool> v_mode: true;

    // 标点特性
    in-out property <bool> slash_to_dunhao: true;
    in-out property <bool> protect_digits_punctuation: true;
    in-out property <bool> auto_complete_pairs: true;

    SettingCard {
        title: "初始输入状态";
        subtitle: "配置输入法启动时的默认语言、字符全半角与简繁体模式";

        HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "输入语言:"; vertical-alignment: center; width: 80px; }
                    ComboBox {
                        model: ["中文 (默认)", "英文"];
                        current-index <=> root.init_lang_index;
                        width: 140px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "字符宽度:"; vertical-alignment: center; width: 80px; }
                    ComboBox {
                        model: ["半角字符", "全角字符"];
                        current-index <=> root.init_char_width_index;
                        width: 140px;
                    }
                }
            }
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "标点符号:"; vertical-alignment: center; width: 80px; }
                    ComboBox {
                        model: ["全角 (中文标点)", "半角 (英文标点)"];
                        current-index <=> root.init_punct_width_index;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "简繁模式:"; vertical-alignment: center; width: 80px; }
                    ComboBox {
                        model: ["简体中文", "繁体中文"];
                        current-index <=> root.init_simp_trad_index;
                        width: 160px;
                    }
                }
            }
        }
    }

    SettingCard {
        title: "候选框外观与排版";
        subtitle: "定制候选框排列方向、字体大小、候选容量与主题色彩";

        HorizontalLayout {
            spacing: 24px;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "排列方向:"; vertical-alignment: center; width: 80px; }
                    ComboBox {
                        model: ["水平横向排列", "垂直纵向排列"];
                        current-index <=> root.orientation_index;
                        width: 150px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "界面主题:"; vertical-alignment: center; width: 80px; }
                    ComboBox {
                        model: ["浅色模式 (Light)", "深色模式 (Dark)"];
                        current-index <=> root.theme_index;
                        width: 150px;
                    }
                }
            }
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "候选词数 (" + Math.round(root.page_size_val) + "):"; vertical-alignment: center; width: 100px; }
                    Slider {
                        minimum: 5;
                        maximum: 9;
                        value <=> root.page_size_val;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "候选字号 (" + Math.round(root.font_size_val) + "px):"; vertical-alignment: center; width: 100px; }
                    Slider {
                        minimum: 12;
                        maximum: 24;
                        value <=> root.font_size_val;
                        width: 160px;
                    }
                }
            }
        }
    }

    SettingCard {
        title: "候选词与输入行为";
        subtitle: "根据个人击键习惯优化选词效率与排版细节";

        CheckBox {
            text: "动态调整候选词词频（基于用户击键自适应学习）";
            checked <=> root.dynamic_adjust_freq;
        }
        CheckBox {
            text: "使用 Shift 键选择第二候选词";
            checked <=> root.shift_select_second;
        }
        CheckBox {
            text: "中西文智能空格（盘古之白，自动在中英文与数字交界处插入半角空格）";
            checked <=> root.auto_pangu_spacing;
        }
        CheckBox {
            text: "启用 V 模式（支持快速四则运算计算器与快捷符号转换）";
            checked <=> root.v_mode;
        }
    }

    SettingCard {
        title: "标点特性与保护";
        subtitle: "提供智能标点转换与格式防错保护";

        CheckBox {
            text: "斜杠转顿号（敲击 /? 键直接输入顿号 、）";
            checked <=> root.slash_to_dunhao;
        }
        CheckBox {
            text: "数字间英文标点保护（如 12:00、3.14 自动保持半角英文符号）";
            checked <=> root.protect_digits_punctuation;
        }
        CheckBox {
            text: "成对符号自动补全（输入括号或引号时自动补齐闭合符号并左移光标）";
            checked <=> root.auto_complete_pairs;
        }
    }
}
