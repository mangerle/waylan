import { ComboBox } from "std-widgets.slint";
import { SettingCard, AppCheckBox, AppSlider } from "common.slint";

export component GeneralTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    // 初始状态属性
    in-out property <int> init_lang_index: 0;       // 0: 中文, 1: 英文
    in-out property <int> init_char_width_index: 0; // 0: 半角, 1: 全角
    in-out property <int> init_punct_width_index: 0;// 0: 全角标点, 1: 半角标点
    in-out property <int> init_simp_trad_index: 0;  // 0: 简体中文, 1: 繁体中文

    // 候选词与打字行为
    in-out property <bool> dynamic_adjust_freq: true;
    in-out property <bool> shift_select_second: false;
    in-out property <bool> auto_pangu_spacing: false;
    in-out property <bool> v_mode: true;

    // 标点特性
    in-out property <bool> slash_to_dunhao: true;
    in-out property <bool> backslash_to_dunhao: true;
    in-out property <bool> protect_digits_punctuation: true;
    in-out property <bool> auto_complete_pairs: true;

    // 系统托盘与指示器
    in-out property <int> enable_tray_index: 0;         // 0: 自动检测, 1: 强制启用彩色托盘, 2: 强制关闭独立托盘
    in-out property <bool> exclusive_input_source: false;

    // 多窗口与终端模式
    in-out property <bool> window_mode_memory: true;
    in-out property <bool> terminal_default_english: true;

    // 候选框基础排版与容量习惯
    in-out property <int> orientation_index: 0;         // 0: 水平横排, 1: 垂直竖排
    in-out property <int> index_style_index: 0;         // 0: 现代风, 1: 经典点号, 2: 圆圈序号, 3: 方括号, 4: 圆括号, 5: 极简标点, 6: 纯文本
    in-out property <float> page_size_val: 5;
    in-out property <float> font_size_val: 15;

    SettingCard {
        title: "初始输入状态";
        subtitle: "配置输入法启动时的默认语言、字符全半角与简繁体模式";

        HorizontalLayout {
            spacing: 28px;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "输入语言:"; vertical-alignment: center; width: 80px; font-size: 13px; color: #334155; }
                    ComboBox {
                        model: ["中文 (默认)", "英文"];
                        current-index <=> root.init_lang_index;
                        width: 150px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "字符宽度:"; vertical-alignment: center; width: 80px; font-size: 13px; color: #334155; }
                    ComboBox {
                        model: ["半角字符", "全角字符"];
                        current-index <=> root.init_char_width_index;
                        width: 150px;
                    }
                }
            }
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "标点符号:"; vertical-alignment: center; width: 80px; font-size: 13px; color: #334155; }
                    ComboBox {
                        model: ["全角 (中文标点)", "半角 (英文标点)"];
                        current-index <=> root.init_punct_width_index;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "简繁模式:"; vertical-alignment: center; width: 80px; font-size: 13px; color: #334155; }
                    ComboBox {
                        model: ["简体中文", "繁体中文"];
                        current-index <=> root.init_simp_trad_index;
                        width: 160px;
                    }
                }
            }
        }
    }

    SettingCard {
        title: "候选词与输入行为";
        subtitle: "根据个人击键习惯优化选词效率与排版细节";

        AppCheckBox {
            text: "动态调整候选词词频（基于用户击键自适应学习）";
            checked <=> root.dynamic_adjust_freq;
        }
        AppCheckBox {
            text: "使用 Shift+数字键选择对应候选词";
            checked <=> root.shift_select_second;
        }
        AppCheckBox {
            text: "中西文智能空格（盘古之白，自动在中英文与数字交界处插入半角空格）";
            checked <=> root.auto_pangu_spacing;
        }
        AppCheckBox {
            text: "启用 V 模式（支持快速四则运算计算器与快捷符号转换）";
            checked <=> root.v_mode;
        }
        AppCheckBox {
            text: "多窗口输入模式独立记忆（不同应用窗口独立保持中英文状态）";
            checked <=> root.window_mode_memory;
        }
        AppCheckBox {
            text: "终端类应用新窗口默认使用英文（终端首次获焦自动设为英文模式）";
            checked <=> root.terminal_default_english;
        }
    }

    SettingCard {
        title: "字体尺寸与候选容量";
        subtitle: "定制单页候选词容量、字体大小、排列方向与序号展示符号";

        HorizontalLayout {
            spacing: 28px;
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "排列方向:"; vertical-alignment: center; width: 80px; font-size: 13px; color: #334155; }
                    ComboBox {
                        model: ["水平横向排列", "垂直纵向排列"];
                        current-index <=> root.orientation_index;
                        width: 170px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "序号样式:"; vertical-alignment: center; width: 80px; font-size: 13px; color: #334155; }
                    ComboBox {
                        model: ["现代 (1 词)", "经典点号 (1. 词)", "圆圈序号 (① 词)", "方括号 ([1] 词)", "圆括号 ((1) 词)", "极简标点 (• 词)", "纯文本 (无序号)"];
                        current-index <=> root.index_style_index;
                        width: 170px;
                    }
                }
            }
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "候选词数 (" + Math.round(root.page_size_val) + "):"; vertical-alignment: center; width: 105px; font-size: 13px; color: #334155; }
                    AppSlider {
                        minimum: 5;
                        maximum: 9;
                        value <=> root.page_size_val;
                        width: 160px;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text { text: "候选字号 (" + Math.round(root.font_size_val) + "px):"; vertical-alignment: center; width: 105px; font-size: 13px; color: #334155; }
                    AppSlider {
                        minimum: 12;
                        maximum: 24;
                        value <=> root.font_size_val;
                        width: 160px;
                    }
                }
            }
        }
    }

    SettingCard {
        title: "标点特性与保护";
        subtitle: "提供智能标点转换与格式防错保护";

        AppCheckBox {
            text: "反斜杠转顿号（敲击 \\| 键直接输入顿号 、）";
            checked <=> root.backslash_to_dunhao;
        }
        AppCheckBox {
            text: "斜杠转顿号（敲击 /? 键直接输入顿号 、）";
            checked <=> root.slash_to_dunhao;
        }
        AppCheckBox {
            text: "数字间英文标点保护（如 12:00、3.14 自动保持半角英文符号）";
            checked <=> root.protect_digits_punctuation;
        }
        AppCheckBox {
            text: "成对符号自动补全（输入括号或引号时自动补齐闭合符号并左移光标）";
            checked <=> root.auto_complete_pairs;
        }
    }

    SettingCard {
        title: "系统托盘与指示器";
        subtitle: "配置桌面顶栏指示器显示形态（提供专属彩色托盘与系统原生单图标等多种风格）";

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Text { text: "指示器形态:"; vertical-alignment: center; width: 90px; }
            ComboBox {
                model: [
                    "微澜专属彩色托盘 (隐藏系统原生白色图标)",
                    "GNOME 原生单图标 (融入系统，关闭微澜独立托盘)",
                    "双指示器并存 (同时显示原生图标与微澜彩色托盘)"
                ];
                current-index <=> root.enable_tray_index;
                width: 330px;
            }
        }
    }
}
