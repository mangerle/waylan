import { CheckBox, ComboBox } from "std-widgets.slint";
import { SettingCard } from "common.slint";

export component PinyinTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    // 拼音检索
    in-out property <bool> enable_acronym: true;

    // 翻页按键多选开关
    in-out property <bool> page_keys_minus_equal: true;
    in-out property <bool> page_keys_bracket: false;
    in-out property <bool> page_keys_comma_period: false;

    // 纠错规则
    in-out property <bool> typo_enable: false;
    in-out property <bool> typo_gn_ng: true;
    in-out property <bool> typo_mg_ng: true;
    in-out property <bool> typo_iou_iu: true;
    in-out property <bool> typo_uei_ui: true;
    in-out property <bool> typo_uen_un: true;
    in-out property <bool> typo_ue_ve: true;
    in-out property <bool> typo_v_u: true;
    in-out property <bool> typo_on_ong: true;

    SettingCard {
        title: "拼音匹配模式";
        subtitle: "选择音节检索与切分方式";

        CheckBox {
            text: "全拼（完整拼音音节匹配，默认常开）";
            checked: true;
            enabled: false;
        }
        CheckBox {
            text: "简拼（声母缩写快速匹配，例如输入 'bj' 候选 '北京'）";
            checked <=> root.enable_acronym;
        }
    }

    SettingCard {
        title: "候选翻页快捷键";
        subtitle: "配置候选词列表翻页按键映射（支持多选同时生效）";

        HorizontalLayout {
            spacing: 24px;
            alignment: start;

            CheckBox {
                text: "减号/等号 (- / =)";
                checked <=> root.page_keys_minus_equal;
            }
            CheckBox {
                text: "中括号 ([ / ])";
                checked <=> root.page_keys_bracket;
            }
            CheckBox {
                text: "逗号/句号 (, / .)";
                checked <=> root.page_keys_comma_period;
            }
        }

        Text {
            text: "注: 键盘 PageUp / PageDown 键始终支持翻页。";
            font-size: 12px;
            color: #94a3b8;
        }
    }

    SettingCard {
        title: "拼音纠错选项";
        subtitle: "自动识别并修正拼音键入过程中的常见击键笔误与旧拼音格式";

        CheckBox {
            text: "启用拼音自动纠错功能";
            checked <=> root.typo_enable;
        }

        Rectangle {
            height: 1px;
            background: #f1f5f9;
        }

        HorizontalLayout {
            spacing: 32px;

            VerticalLayout {
                spacing: 10px;
                CheckBox {
                    text: "gn -> ng (例如: zhangn -> zhang)";
                    checked <=> root.typo_gn_ng;
                    enabled: root.typo_enable;
                }
                CheckBox {
                    text: "mg -> ng (例如: zhangm -> zhang)";
                    checked <=> root.typo_mg_ng;
                    enabled: root.typo_enable;
                }
                CheckBox {
                    text: "iou -> iu (例如: niou -> niu)";
                    checked <=> root.typo_iou_iu;
                    enabled: root.typo_enable;
                }
                CheckBox {
                    text: "uei -> ui (例如: guei -> gui)";
                    checked <=> root.typo_uei_ui;
                    enabled: root.typo_enable;
                }
            }

            VerticalLayout {
                spacing: 10px;
                CheckBox {
                    text: "uen -> un (例如: luen -> lun)";
                    checked <=> root.typo_uen_un;
                    enabled: root.typo_enable;
                }
                CheckBox {
                    text: "ue -> ve (例如: jue -> jve)";
                    checked <=> root.typo_ue_ve;
                    enabled: root.typo_enable;
                }
                CheckBox {
                    text: "v -> u (例如: lv -> lu)";
                    checked <=> root.typo_v_u;
                    enabled: root.typo_enable;
                }
                CheckBox {
                    text: "on -> ong (例如: zon -> zong)";
                    checked <=> root.typo_on_ong;
                    enabled: root.typo_enable;
                }
            }
        }
    }
}
