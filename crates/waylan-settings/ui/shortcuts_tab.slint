import { ComboBox } from "std-widgets.slint";
import { SettingCard, Keycap, AppCheckBox, ShortcutRecorder } from "common.slint";

export component ShortcutsTab inherits VerticalLayout {
    spacing: 16px;
    padding-right: 8px;

    in-out property <int> switch_key_index: 0;
    in-out property <bool> page_keys_minus_equal: true;
    in-out property <bool> page_keys_bracket: false;
    in-out property <bool> page_keys_comma_period: false;

    in-out property <string> traditional_shortcut: "Ctrl + Shift + F";
    in-out property <string> full_width_char_shortcut: "Shift + Space";
    in-out property <string> full_width_punct_shortcut: "Ctrl + .";

    SettingCard {
        title: "常用按键与翻页配置";
        subtitle: "自定义中英文状态切换与候选列表翻页控制键";

        VerticalLayout {
            spacing: 16px;

            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "中英文状态切换按键"; font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: "单次敲击指定按键在中文输入与英文输入之间即时切换"; font-size: 12px; color: #64748b; }
                }
                ComboBox {
                    model: ["Shift 键", "Ctrl 键"];
                    current-index <=> root.switch_key_index;
                    width: 160px;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            VerticalLayout {
                spacing: 10px;
                Text { text: "候选翻页按键"; font-size: 13px; font-weight: 600; color: #0f172a; }
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    AppCheckBox {
                        text: "减号 / 等号 (- / =)";
                        checked <=> root.page_keys_minus_equal;
                    }
                    AppCheckBox {
                        text: "中括号 ([ / ])";
                        checked <=> root.page_keys_bracket;
                    }
                    AppCheckBox {
                        text: "逗号 / 句号 (, / .)";
                        checked <=> root.page_keys_comma_period;
                    }
                }
                Text {
                    text: "注: 键盘物理 PageUp / PageDown 键始终支持快速翻页。";
                    font-size: 12px;
                    color: #94a3b8;
                }
            }
        }
    }

    SettingCard {
        title: "模式即时切换快捷键";
        subtitle: "配置简繁体、字符全半角与标点符号状态的全局切换组合键（即时生效）";

        VerticalLayout {
            spacing: 14px;

            // 简繁切换
            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "简繁体即时切换"; font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: "在简体中文与繁体中文输出模式之间无缝转换"; font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.traditional_shortcut;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            // 字符全半角切换
            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "字符全角 / 半角切换"; font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: "切换字母与数字的半角宽度或全角宽度形态"; font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.full_width_char_shortcut;
                }
            }

            Rectangle { height: 1px; background: #f1f5f9; }

            // 标点全半角切换
            HorizontalLayout {
                spacing: 16px;
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text { text: "标点全角 / 半角切换"; font-size: 13px; font-weight: 600; color: #0f172a; }
                    Text { text: "切换中文全角标点符号与英文半角标点符号"; font-size: 12px; color: #64748b; }
                }
                ShortcutRecorder {
                    shortcut <=> root.full_width_punct_shortcut;
                }
            }
        }
    }

    SettingCard {
        title: "基础选词快捷说明";
        subtitle: "输入法核心标准选词按键定义";

        HorizontalLayout {
            spacing: 24px;
            alignment: start;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: "首选词确认:"; font-size: 13px; color: #64748b; vertical-alignment: center; }
                Keycap { text: "Space (空格)"; }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: "数字选词:"; font-size: 13px; color: #64748b; vertical-alignment: center; }
                Keycap { text: "1"; }
                Text { text: "-"; font-size: 12px; color: #94a3b8; vertical-alignment: center; }
                Keycap { text: "9"; }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: "特殊扩展:"; font-size: 13px; color: #64748b; vertical-alignment: center; }
                Keycap { text: "v"; }
                Text { text: "计算/日期"; font-size: 12px; color: #64748b; vertical-alignment: center; }
            }
        }
    }
}


