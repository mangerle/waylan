import { ComboBox } from "std-widgets.slint";
import { SettingCard, AppSwitch, SecondaryButton } from "common.slint";

export component VoiceStageFourCard inherits SettingCard {
    title: "阶段四：文本后处理与标点预测 (Punctuation)";
    subtitle: "识别文字生成后，根据上下文语义自动预测并插入标点符号";

    in-out property <bool> auto_punctuation: true;
    in property <[string]> punct_model_names: [];
    in-out property <int> punct_model_index: 0;

    callback import_punct_model();

    VerticalLayout {
        spacing: 14px;

        // 阶段四总控开关
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "启用标点预测还原总控"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "关闭后识别文本将原样上屏，不自动在句子中插入逗号、句号与问号";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.auto_punctuation;
                    text: root.auto_punctuation ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 标点模型选择
        VerticalLayout {
            spacing: 8px;
            opacity: root.auto_punctuation ? 1.0 : 0.4;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "选用标点预测模型算法"; font-size: 13px; font-weight: 600; color: #0f172a; }
                SecondaryButton {
                    text: "导入标点模型";
                    clicked => {
                        if (root.auto_punctuation) { root.import_punct_model(); }
                    }
                }
            }
            Text {
                text: "利用深度 Transformer 网络或基础智能规则恢复标点符号";
                font-size: 12px;
                color: #64748b;
            }
            ComboBox {
                enabled: root.auto_punctuation;
                model: root.punct_model_names;
                current-index <=> root.punct_model_index;
            }
        }
    }
}

export component VoiceStageFiveCard inherits SettingCard {
    title: "阶段五：文本规整与语气词过滤 (ITN)";
    subtitle: "识别文本输出后，自动进行大写数字转换、口语停顿语气词消除与中英文盘古空格规整";

    in-out property <bool> convert_numbers: true;
    in-out property <bool> filter_filler_words: true;
    in-out property <bool> pangu_spacing: true;

    VerticalLayout {
        spacing: 14px;

        // 开关 1：大写数字自动转阿拉伯数字
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "1. 大写数字自动转阿拉伯数字 (ITN)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "将口述大写数字转换为标准阿拉伯数字（如“三点五”转“3.5”、“一九九八年”转“1998年”）";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.convert_numbers;
                    text: root.convert_numbers ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 2：口语停顿语气词自动过滤
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "2. 口语停顿语气词自动过滤 (Disfluency)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "自动消除无意义口头禅（过滤孤立的“呃、啊、嗯、哦”与结巴重复，保护后接名词的指示代词）";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.filter_filler_words;
                    text: root.filter_filler_words ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 3：中英文自动盘古空格
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "3. 中英文自动盘古空格 (Pangu Spacing)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "自动在中文字符与半角英文之间补充排版空格，并优雅保护全角中文标点与数字量词";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.pangu_spacing;
                    text: root.pangu_spacing ? "已开启" : "已关闭";
                }
            }
        }
    }
}

export component VoiceStageSixCard inherits SettingCard {
    title: "阶段六：交互展现与流式上屏";
    subtitle: "控制语音识别过程中的视觉反馈方式，支持光标处实时出字与现代化动态声浪";

    in property <bool> custom_theme_enabled: true;
    in-out property <bool> real_time_preview: true;
    in-out property <bool> show_floating_bar: true;
    in-out property <int> voice_visual_effect_index: 0;

    VerticalLayout {
        spacing: 14px;

        // 开关 1：光标处实时文字预览
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "1. 光标处实时文字预览 (Inline Preedit)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "开启后边说边在当前光标处显示带下划线的未确认文字；关闭后录音时保持静默，停顿或松手后整句上屏";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.real_time_preview;
                    text: root.real_time_preview ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 2：显示录音浮动波形条
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "2. 显示录音浮动波形条 (Floating Waveform)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "录音时在光标处弹出单行音量胶囊条展示实时跳动波形；关闭后彻底静默、不弹候选框";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.show_floating_bar;
                    text: root.show_floating_bar ? "已开启" : "已隐藏";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 3：语音动效视觉风格
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            opacity: (root.custom_theme_enabled && root.show_floating_bar) ? 1.0 : 0.4;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "3. 语音浮层动效风格 (Visual Effect)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: !root.show_floating_bar ?
                        "当前已关闭上方【录音浮动波形条】（静默录音模式），光标处不显示悬浮条，动效设置已锁定" :
                        (!root.custom_theme_enabled ?
                            "当前处于桌面系统原生渲染模式，仅支持经典纯文本；需在【外观与主题】中开启微澜现代专属模式后方可解锁多频声浪与呼吸光环" :
                            "选择录音时的视觉呈现形态（跳动多频律动声浪柱、流光呼吸光环微卡片或经典纯文字提示）");
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                ComboBox {
                    enabled: root.custom_theme_enabled && root.show_floating_bar;
                    model: root.custom_theme_enabled ?
                        ["现代多频律动声浪胶囊 (推荐)", "流光呼吸光环微卡片", "经典文本提示 (正在聆听)"] :
                        ["系统原生经典文本提示 (锁定)"];
                    current-index <=> root.voice_visual_effect_index;
                    width: 230px;
                }
            }
        }

        // 语音浮层独立实时视觉效果预览卡片
        if root.show_floating_bar && root.custom_theme_enabled: Rectangle {
            background: #f8fafc;
            border-radius: 6px;
            border-width: 1px;
            border-color: #e2e8f0;
            HorizontalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                spacing: 12px;

                Text { text: "录音浮层实机效果预览:"; font-size: 11px; color: #64748b; vertical-alignment: center; }

                // 悬浮胶囊外形
                Rectangle {
                    background: #ffffff;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: rgba(0, 0, 0, 0.06);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 8px;
                        alignment: center;

                        // 律动声浪胶囊
                        if root.voice_visual_effect_index == 0: HorizontalLayout {
                            spacing: 3px;
                            alignment: center;
                            Rectangle { width: 3px; height: 8px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 16px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 12px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 18px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 9px; border-radius: 2px; background: #07c160; }
                        }

                        // 流光呼吸光环微卡片
                        if root.voice_visual_effect_index == 1: Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: #07c160;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: rgba(7, 193, 96, 0.6);
                        }

                        Text {
                            text: "正在聆听...";
                            font-size: 12px;
                            font-weight: 500;
                            color: #1e293b;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
