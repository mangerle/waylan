import { ComboBox, ProgressIndicator } from "std-widgets.slint";
import { SettingCard, AppSwitch, PrimaryButton, SecondaryButton, AsrModelCardItem } from "common.slint";

export component VoiceStageFourCard inherits SettingCard {
    title: "阶段四：文本后处理与自动标点 (Punctuation)";
    subtitle: "控制识别文字生成后是否保留原生智能标点符号";

    in-out property <bool> auto_punctuation: true;

    VerticalLayout {
        spacing: 14px;

        // 阶段四总控开关：自动标点符号
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "自动标点符号"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "SenseVoice 与 Fun-ASR 模型原生自带端到端标点预测；关闭后将滤除所有标点符号，仅输出纯文本字符";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.auto_punctuation;
                    text: root.auto_punctuation ? "已开启" : "已关闭";
                }
            }
        }
    }
}

export component VoiceStageFiveCard inherits SettingCard {
    title: "阶段五：文本规整与语气词过滤 (ITN)";
    subtitle: "识别文本输出后，自动进行大写数字转换、口语停顿语气词消除与中英文盘古空格规整";

    in-out property <bool> convert_numbers: true;
    in-out property <bool> filter_filler_words: true;
    in-out property <bool> pangu_spacing: true;

    VerticalLayout {
        spacing: 14px;

        // 开关 1：大写数字自动转阿拉伯数字
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "1. 大写数字自动转阿拉伯数字 (ITN)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "将口述大写数字转换为标准阿拉伯数字（如“三点五”转“3.5”、“一九九八年”转“1998年”）";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.convert_numbers;
                    text: root.convert_numbers ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 2：口语停顿语气词自动过滤
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "2. 口语停顿语气词自动过滤 (Disfluency)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "自动消除无意义口头禅（过滤孤立的“呃、啊、嗯、哦”与结巴重复，保护后接名词的指示代词）";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.filter_filler_words;
                    text: root.filter_filler_words ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 3：中英文自动盘古空格
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "3. 中英文自动盘古空格 (Pangu Spacing)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "自动在中文字符与半角英文之间补充排版空格，并优雅保护全角中文标点与数字量词";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.pangu_spacing;
                    text: root.pangu_spacing ? "已开启" : "已关闭";
                }
            }
        }
    }
}

export component VoiceStageSixCard inherits SettingCard {
    title: "阶段六：交互展现与流式上屏";
    subtitle: "控制语音识别过程中的视觉反馈方式，支持光标处实时出字与现代化动态声浪";

    in property <bool> custom_theme_enabled: true;
    in-out property <bool> real_time_preview: true;
    in-out property <bool> show_floating_bar: true;
    in-out property <int> voice_visual_effect_index: 0;

    VerticalLayout {
        spacing: 14px;

        // 开关 1：光标处实时文字预览
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "1. 光标处实时文字预览 (Inline Preedit)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "开启后边说边在当前光标处显示带下划线的未确认文字；关闭后录音时保持静默，停顿或松手后整句上屏";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.real_time_preview;
                    text: root.real_time_preview ? "已开启" : "已关闭";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 2：显示录音浮动波形条
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "2. 显示录音浮动波形条 (Floating Waveform)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: "录音时在光标处弹出单行音量胶囊条展示实时跳动波形；关闭后彻底静默、不弹候选框";
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                AppSwitch {
                    checked <=> root.show_floating_bar;
                    text: root.show_floating_bar ? "已开启" : "已隐藏";
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 开关 3：语音动效视觉风格
        HorizontalLayout {
            spacing: 16px;
            alignment: space-between;
            opacity: (root.custom_theme_enabled && root.show_floating_bar) ? 1.0 : 0.4;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;
                Text { text: "3. 语音浮层动效风格 (Visual Effect)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text {
                    text: !root.show_floating_bar ?
                        "当前已关闭上方【录音浮动波形条】（静默录音模式），光标处不显示悬浮条，动效设置已锁定" :
                        (!root.custom_theme_enabled ?
                            "当前处于桌面系统原生渲染模式，仅支持经典纯文本；需在【外观与主题】中开启微澜现代专属模式后方可解锁多频声浪与呼吸光环" :
                            "选择录音时的视觉呈现形态（跳动多频律动声浪柱、流光呼吸光环微卡片或经典纯文字提示）");
                    font-size: 12px;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                ComboBox {
                    enabled: root.custom_theme_enabled && root.show_floating_bar;
                    model: root.custom_theme_enabled ?
                        ["现代多频律动声浪胶囊 (推荐)", "流光呼吸光环微卡片", "经典文本提示 (正在聆听)"] :
                        ["系统原生经典文本提示 (锁定)"];
                    current-index <=> root.voice_visual_effect_index;
                    width: 230px;
                }
            }
        }

        // 语音浮层独立实时视觉效果预览卡片
        if root.show_floating_bar && root.custom_theme_enabled: Rectangle {
            background: #f8fafc;
            border-radius: 6px;
            border-width: 1px;
            border-color: #e2e8f0;
            HorizontalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                spacing: 12px;

                Text { text: "录音浮层实机效果预览:"; font-size: 11px; color: #64748b; vertical-alignment: center; }

                // 悬浮胶囊外形
                Rectangle {
                    background: #ffffff;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: rgba(0, 0, 0, 0.06);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 8px;
                        alignment: center;

                        // 律动声浪胶囊
                        if root.voice_visual_effect_index == 0: HorizontalLayout {
                            spacing: 3px;
                            alignment: center;
                            Rectangle { width: 3px; height: 8px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 16px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 12px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 18px; border-radius: 2px; background: #07c160; }
                            Rectangle { width: 3px; height: 9px; border-radius: 2px; background: #07c160; }
                        }

                        // 流光呼吸光环微卡片
                        if root.voice_visual_effect_index == 1: Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: #07c160;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: rgba(7, 193, 96, 0.6);
                        }

                        Text {
                            text: "正在聆听...";
                            font-size: 12px;
                            font-weight: 500;
                            color: #1e293b;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component VoiceStageThreeCard inherits SettingCard {
    title: "阶段三：核心语音识别与转写 (ASR)";
    subtitle: "统一汇集端侧离线语音大模型、本地自定义导入与线上云端 Whisper 兼容服务";

    in property <[AsrModelCardItem]> asr_models: [];
    in property <[string]> asr_model_names: [];
    in-out property <int> asr_model_index: 0;
    in property <string> asr_notice_text: "";
    in property <bool> is_asr_cloud: false;

    callback switch_to_cloud_tab();
    callback import_asr_model();
    callback open_models_directory();
    callback download_model(string);
    callback activate_model(string);

    VerticalLayout {
        spacing: 14px;

        // 顶部操作栏
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text { text: "选用语音识别核心模型 (ASR Engine)"; font-size: 13px; font-weight: 600; color: #0f172a; }
                Text { text: "从下拉框统一挑选目标模型，未下载的离线大模型可就地一键流式下载部署并即时启用"; font-size: 11px; color: #64748b; }
            }
            HorizontalLayout {
                spacing: 8px;
                SecondaryButton {
                    text: "管理云端服务 »";
                    clicked => { root.switch_to_cloud_tab(); }
                }
                SecondaryButton {
                    text: "导入本地模型";
                    clicked => { root.import_asr_model(); }
                }
                SecondaryButton {
                    text: "打开模型存放目录";
                    clicked => { root.open_models_directory(); }
                }
            }
        }

        // 统一模型下拉选择栏
        HorizontalLayout {
            spacing: 14px;
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text { text: "识别模型选择 (官方 / 本地 / 云端大统一):"; font-size: 13px; font-weight: 600; color: #334155; }
            }
            HorizontalLayout {
                spacing: 8px;
                ComboBox {
                    model: root.asr_model_names;
                    current-index <=> root.asr_model_index;
                    width: 440px;
                }
            }
        }

        Rectangle { height: 1px; background: #f1f5f9; }

        // 选定模型详情与部署卡片（根据下拉选中的项动态就地展示）
        for item[idx] in root.asr_models: VerticalLayout {
            if idx == root.asr_model_index: Rectangle {
                background: (item.state == 3 || item.state == 4) ? #f0fdf4 : #ffffff;
                border-radius: 8px;
                border-width: 1px;
                border-color: (item.state == 3 || item.state == 4) ? #86efac : #e2e8f0;

                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: space-between;

                        // 左侧模型名称、徽章与体积延迟
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: center;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: item.name;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: #0f172a;
                                    vertical-alignment: center;
                                }

                                // 徽章
                                Rectangle {
                                    background: (item.state == 3 || item.state == 4) ? #dcfce7 : #eff6ff;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: (item.state == 3 || item.state == 4) ? #bbf7d0 : #bfdbfe;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 2px;
                                        padding-bottom: 2px;
                                        Text {
                                            text: item.badge;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: (item.state == 3 || item.state == 4) ? #15803d : #1d4ed8;
                                        }
                                    }
                                }

                                Text {
                                    text: item.size_desc;
                                    font-size: 11px;
                                    color: #64748b;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: item.desc;
                                font-size: 12px;
                                color: #475569;
                                wrap: word-wrap;
                            }

                            if item.path_or_url != "": Text {
                                text: "存储路径/端点: " + item.path_or_url;
                                font-size: 11px;
                                color: #94a3b8;
                                wrap: word-wrap;
                            }
                        }

                        // 右侧状态与操作按钮
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            alignment: end;
                            spacing: 8px;

                            // 状态 0: 离线模型未下载
                            if item.state == 0: SecondaryButton {
                                text: "下载并部署";
                                clicked => { root.download_model(item.id); }
                            }

                            // 状态 1: 正在下载中
                            if item.state == 1: Rectangle {
                                background: #eff6ff;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #bfdbfe;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "下载中...";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #2563eb;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 状态 2: 离线模型已下载，待启用
                            if item.state == 2: PrimaryButton {
                                text: "立即启用";
                                clicked => { root.activate_model(item.id); }
                            }

                            // 状态 3: 离线模型当前生效使用中
                            if item.state == 3: Rectangle {
                                background: #dcfce7;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #86efac;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: center;
                                    Text {
                                        text: "使用中 (生效中)";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #166534;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 状态 4: 云端/自定义当前生效中
                            if item.state == 4: Rectangle {
                                background: #dcfce7;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #86efac;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    alignment: center;
                                    Text {
                                        text: "使用中 (当前模式)";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #166534;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // 状态 5: 云端/自定义待启用
                            if item.state == 5: PrimaryButton {
                                text: "设为当前生效";
                                clicked => { root.activate_model(item.id); }
                            }
                        }
                    }

                    // 下载中的进度条与速度展示
                    if item.state == 1: VerticalLayout {
                        spacing: 4px;
                        ProgressIndicator {
                            progress: max(0.02, min(1.0, item.progress));
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: item.progress_text;
                                font-size: 11px;
                                color: #2563eb;
                                font-weight: 500;
                            }
                            Text {
                                text: "高速镜像源: ModelScope";
                                font-size: 11px;
                                color: #94a3b8;
                            }
                        }
                    }

                    // 下载未完成时的明确错误提示（防截断）
                    if item.state == 0 && item.progress_text != "": HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: "下载未完成: " + item.progress_text;
                            font-size: 11px;
                            color: #dc2626;
                            font-weight: 500;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // 模型特性与安全隐私提示胶囊
        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: root.is_asr_cloud ? #bfdbfe : #bbf7d0;
            background: root.is_asr_cloud ? #eff6ff : #f0fdf4;

            HorizontalLayout {
                padding: 10px;
                Text {
                    text: root.asr_notice_text;
                    font-size: 12px;
                    color: root.is_asr_cloud ? #1e40af : #15803d;
                    wrap: word-wrap;
                }
            }
        }
    }
}
